DATABASE_URL=postgres://ppbudget:ppbudget_password@localhost:5432/ppbudget?sslmode=disable
PORT=8080
# Required in any non-local deployment: the backend refuses to start with the
# default values below once FRONTEND_URL is not localhost.
# Generate with: openssl rand -base64 48
INGEST_API_KEY=super-secret-api-key
JWT_SECRET=super-secret-jwt-key
FRONTEND_URL=http://localhost:3000

# Optional: email notifications via Resend (falls back to SMTP if unset)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
